# ===== Auxiliary Wing Contracting (Aux Wing) — production (.htaccess) =====

Options -Indexes

RewriteEngine On

# Canonical host = www.auxwing.com.  Redirect non-www -> www.
# (Enable "Force HTTPS" in Hostinger hPanel to handle http -> https.)
RewriteCond %{HTTP_HOST} ^auxwing\.com [NC]
RewriteRule ^ https://www.auxwing.com%{REQUEST_URI} [L,R=301]

# Clean homepage URL: /index.html -> /
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]

# Custom error page
ErrorDocument 404 /404.html

# GZIP / compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json image/svg+xml
</IfModule>

# Browser caching
<IfModule mod_expires.c>
  ExpiresActive On
  # Images cached 1 day while the site is actively updated (was 1 year).
  # Image URLs are also version-tagged (?v=N) so updates appear instantly.
  ExpiresByType image/webp "access plus 1 day"
  ExpiresByType image/jpeg "access plus 1 day"
  ExpiresByType image/png  "access plus 1 day"
  ExpiresByType image/x-icon "access plus 1 week"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 week"
  ExpiresByType image/svg+xml "access plus 1 day"
  ExpiresByType text/css   "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType text/html  "access plus 0 seconds"
</IfModule>

# Light security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
